---
import SiteLayout from "../layouts/SiteLayout.astro";
import PathCard from "../components/PathCard.astro";
import TopicCard from "../components/TopicCard.astro";
import { lessons, paths, projects, topics } from "../data/learning";

const starterPath = paths.find((path) => path.status === "complete")!;
const starterLessons = starterPath.lessonSlugs
  .slice(0, 3)
  .map((slug) => lessons.find((lesson) => lesson.slug === slug)!);
const starterProject = projects.find((project) => project.slug === starterPath.projectSlug)!;
---

<SiteLayout>
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <span class="hero-kicker">Free technology learning · no account needed</span>
        <h1>Learn a skill.<br />Put it to <em>work.</em></h1>
        <p class="hero-description">Start with the complete web path, explore previews in Python and AI, or use the topic library to find trusted resources. Lessons pair plain-language explanations with practice and a project where one is ready.</p>
        <div class="hero-actions">
          <a href="/paths/" class="button button-dark">Browse learning paths</a>
          <a href="/practice/" class="button button-outline">Try a short exercise</a>
        </div>
        <p class="hero-proof">No payment gate. Your learning progress stays in this browser.</p>
      </div>

      <aside class="hero-visual" aria-label={`Course outline: ${starterPath.title}`}>
        <div class="learning-map">
          <div class="map-head">
            <span class="map-head-label">A complete beginner path</span>
            <span class="map-level">{starterPath.duration}</span>
          </div>
          <div class="map-feature">
            <span class="eyebrow">Start here · {starterPath.category}</span>
            <h2><a href={`/paths/${starterPath.slug}/`}>{starterPath.title}</a></h2>
            <p>{starterPath.description}</p>
          </div>
          <ol class="map-path">
            {starterLessons.map((lesson, index) => (
              <li class="map-step">
                <span class="map-node">{String(index + 1).padStart(2, "0")}</span>
                <span class="map-step-copy">
                  <span class="map-step-title">{lesson.title}</span>
                  <span class="map-step-sub">{lesson.duration}</span>
                </span>
              </li>
            ))}
          </ol>
          <div class="map-project">
            <span class="eyebrow">Finish with a project</span>
            <a href={`/projects/${starterProject.slug}/`}>{starterProject.title}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" id="paths">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Learning paths</span>
          <h2>Choose what you want to learn.</h2>
          <p>The web development path is complete. Python and AI currently have previews. Each card shows what is ready before you begin.</p>
        </div>
        <a href="/paths/" class="text-link">See all paths</a>
      </div>
      <div class="path-grid">{paths.map((path) => <PathCard path={path} />)}</div>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">A useful learning loop</span>
          <h2>Understand it. Try it. Make it yours.</h2>
          <p>Lessons stay focused on one idea at a time, then give you a reason to use it.</p>
        </div>
      </div>
      <div class="learning-loop">
        <article><span>Learn</span><h3>Read a clear explanation</h3><p>Start with plain language, an example, and the key idea to remember.</p></article>
        <article><span>Practise</span><h3>Check your understanding</h3><p>Answer a question or try a small exercise while the lesson is fresh.</p></article>
        <article><span>Build</span><h3>Use it in a project</h3><p>Bring several skills together in a project brief you can adapt and keep.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Topic library</span>
          <h2>Explore the wider world of tech.</h2>
          <p>Browse foundational and newer subjects. We label full paths, previews, and links to trusted learning resources clearly.</p>
        </div>
        <a href="/topics/" class="text-link">Browse all topics</a>
      </div>
      <div class="topic-grid">{topics.slice(0, 8).map((topic) => <TopicCard topic={topic} />)}</div>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell">
      <div class="practice-feature">
        <div>
          <span class="eyebrow">Practice · JavaScript · about 10 minutes</span>
          <h2>Make a greeting from a name.</h2>
          <p>Try a short exercise on template literals, get a hint if you need one, and see why the answer works.</p>
          <a href="/practice/" class="button button-dark">Open the exercise</a>
        </div>
        <div class="practice-example" aria-label="Example of a JavaScript template literal">
          <span>Example</span>
          <code>{"`Hello, ${name}!`"}</code>
        </div>
      </div>

      <div class="library-cta">
        <div>
          <span class="eyebrow">Free and transparent</span>
          <h2>Know what is ready before you begin.</h2>
          <p>Every path and topic says whether it is a complete course, a preview, or a link to an outside resource.</p>
        </div>
        <a href="/about/" class="button button-outline">How free access works</a>
      </div>
    </div>
  </section>
</SiteLayout>
