---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, index) => <span>{index > 0 && <span class="crumb-divider">/</span>}{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</span>)}
</nav>
