---
const pathname = Astro.url.pathname;
const navItems = [
  { href: "/paths/", label: "Learning paths" },
  { href: "/topics/", label: "Explore topics" },
  { href: "/projects/", label: "Projects" },
  { href: "/practice/", label: "Practice" },
];
const isActive = (href: string) => pathname.startsWith(href);
---

<header class="site-header">
  <div class="header-inner shell">
    <a href="/" class="brand" aria-label="DishaStack home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span></span>
      <span>Disha<span class="brand-light">Stack</span></span>
    </a>
    <nav class="main-nav desktop-nav" aria-label="Main navigation">
      {navItems.map((item) => <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
      <a href="/about/" class:list={["nav-link", { active: pathname.startsWith("/about/") }]}>Our free promise</a>
    </nav>
    <div class="header-actions">
      <span class="free-chip"><span class="free-dot"></span>Free, always</span>
      <a href="/dashboard/" class="button button-dark header-cta">My learning</a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu">Menu</summary>
        <nav class="mobile-menu-panel" aria-label="Mobile navigation">
          {navItems.map((item) => <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]}>{item.label}</a>)}
          <a href="/about/" class="nav-link">Our free promise</a>
          <a href="/dashboard/" class="nav-link">My learning</a>
        </nav>
      </details>
    </div>
  </div>
</header>
